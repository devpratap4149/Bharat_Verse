      "type": [
        "string",
        "number",
        "integer",
        "null"
      ]
    },
    "state": {
      "type": [
        "string",
        "number",
        "integer",
        "null"
      ]
    },
    "country": {
      "type": [
        "string",
        "number",
        "integer",
        "null"
      ]
